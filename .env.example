# GitHub repository info for Uses admin page
# These are used to commit changes directly to the repo
NEXT_PUBLIC_GITHUB_OWNER=wbuf81
NEXT_PUBLIC_GITHUB_REPO=wbuf81.github.io

# SNES dataset: a free Twitch developer app (https://dev.twitch.tv/console), used by npm run snes:fetch:igdb.
# Put real values in .env.local, never here.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# SNES media: Wes's scraped clips/logos/3D boxes (images/ and videos/). Never inside out/ — builds wipe it.
SNES_MEDIA_DIR=../snes-media
